# MongoDB Connection URI (Optional for Vercel/Local; fallback memory store activates automatically if omitted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/app_layer_security?retryWrites=true&w=majority

# JWT Secret for session signing
JWT_SECRET=super-secret-alad-security-key-2026

# Port for local dev (optional, default 3000)
PORT=3000
